# ── Backend ─────────────────────────────────────────────────────
JWT_SECRET=local-dev-jwt-secret-change-this
APP_SECRET=local-dev-app-secret-change-this

# ── Database ───────────────────────────────────────────────────
# MySQL connection string (edit user/password/database if your local MySQL differs)
DATABASE_URL=mysql://hiline_dev:HiLineDev123!@127.0.0.1:3306/hiline_pro_care?charset=utf8mb4

# ── Admin Role ──────────────────────────────────────────────────
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=change-this-admin-password

# ── Optional admin promotion ───────────────────────────────────
OWNER_UNION_ID=           # Optional: Union ID for admin promotion on first login

# ── Paymob ─────────────────────────────────────────────────────
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
# Set to true only when requests always pass through a trusted reverse proxy.
TRUST_PROXY=false

# ── Transactional email / password reset (required in production) ─────
# Verify your sending domain first, then use an address on that domain.
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=Hi Line Pro Care <no-reply@example.com>
PASSWORD_RESET_BASE_URL=http://localhost:3000
